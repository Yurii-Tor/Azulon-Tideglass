.card {
    flex-grow: 1;
    min-width: 0;
    background-color: #1c353a;
    border-radius: 8px;
    padding: 10px;
}

.card Label {
    white-space: normal;
    color: #eaf0e6;
    margin: 0;
    padding: 0;
}

.card .row, .card .card-spec {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.card .item-title {
    -unity-font-style: bold;
    font-size: 16px;
    flex-shrink: 1;
}

.card .icon {
    width: 43px;
    height: 43px;
    margin-right: 7px;
    flex-shrink: 0;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.card .card-spec {
    flex-wrap: wrap;
}

.card .card-spec > Label {
    color: #a5d5c6;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-right: 5px;
}

.card .copy {
    color: #c0d1ca;
    font-size: 14px;
}

.card .effect {
    color: #eac88a;
    font-size: 13px;
    margin-top: 3px;
}

.card .card-choice {
    margin-top: auto;
    padding-top: 9px;
}

.card .lens-status {
    color: #a5d5c6;
    font-size: 13px;
    -unity-font-style: bold;
    min-height: 29px;
    -unity-text-align: middle-left;
}

.card .lens-status.locked {
    color: #ecd4a1;
}

.card .is-hidden {
    display: none;
}
