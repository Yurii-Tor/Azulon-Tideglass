.tideglass {
    flex-grow: 1;
    background-color: #101f25;
    color: #eaf0e6;
}

.tideglass .unity-scroll-view {
    flex-grow: 1;
}

.tideglass .page {
    width: 100%;
    max-width: 1480px;
    align-self: center;
    padding: 18px 30px 24px;
}

.tideglass Label {
    white-space: normal;
    color: #eaf0e6;
    margin: 0;
    padding: 0;
}

.tideglass .eyebrow, .tideglass .spec {
    color: #b7cab9;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.tideglass .header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 0 0 12px;
}

.tideglass .masthead {
    font-size: 36px;
    -unity-font-style: bold;
}

.tideglass .badge {
    color: #ecd4a1;
    font-size: 15px;
    -unity-font-style: bold;
}

.tideglass .inline-text {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.tideglass .inline-text > Label {
    margin-right: 5px;
}

.tideglass .station {
    flex-direction: row;
    flex-wrap: wrap;
    background-color: #20393d;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 18px;
}

.tideglass .chart {
    width: 25%;
    max-width: 305px;
    background-color: #173035;
    min-height: 166px;
    justify-content: center;
}

.tideglass .beacon-art {
    width: 100%;
    height: 160px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.tideglass .controls {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 180px;
    padding: 14px 20px;
}

.tideglass .headline {
    font-size: 25px;
    -unity-font-style: bold;
}

.tideglass .copy {
    color: #c0d1ca;
    font-size: 14px;
}

.tideglass .power {
    font-size: 18px;
    color: #f4d396;
    -unity-font-style: bold;
    margin-top: 5px;
}

.tideglass .power-line {
    margin-top: 5px;
}

.tideglass .power-line > Label {
    margin-top: 0;
}

.tideglass .track {
    background-color: #0e272c;
    height: 5px;
    border-radius: 3px;
    margin-top: 5px;
}

.tideglass .fill {
    height: 5px;
    width: 0;
    background-color: #e3bf77;
    border-radius: 3px;
}

.tideglass .beam-hint {
    color: #eac88a;
    font-size: 13px;
    margin-top: 7px;
}

.tideglass .sockets-label {
    margin-top: 7px;
}

.tideglass .socket {
    background-color: #173035;
    border-radius: 3px;
    padding: 4px 7px;
    margin-top: 3px;
}

.tideglass .socket > Label {
    color: #d6e8dc;
    font-size: 12px;
    flex-shrink: 1;
}

.tideglass .grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.tideglass .card-host {
    width: 32%;
    margin-right: 1%;
    margin-top: 6px;
}

.tideglass .spec {
    color: #a5d5c6;
    margin-bottom: 4px;
}

.tideglass .inventory {
    width: 33%;
    min-width: 242px;
    padding: 14px;
    background-color: #182f35;
}

.tideglass .section {
    font-size: 23px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.tideglass .inventory-heading {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
}

.tideglass .inventory .section {
    font-size: 20px;
}

.tideglass .slot {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    padding: 4px 8px;
    margin-top: 5px;
    background-color: #132e32;
    border-radius: 5px;
}

.tideglass .slot .icon {
    width: 30px;
    height: 30px;
    margin-right: 7px;
    flex-shrink: 0;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.tideglass .slot-filled {
    flex-direction: row;
    flex-grow: 1;
    min-width: 0;
    align-items: center;
}

.tideglass .slot-detail {
    flex-grow: 1;
    min-width: 0;
}

.tideglass .slot-title {
    font-size: 14px;
    -unity-font-style: bold;
}

.tideglass .slot-power {
    color: #b7cab9;
    font-size: 12px;
}

.tideglass Button {
    white-space: normal;
    background-image: none;
    background-color: #315558;
    color: #edf4e8;
    border-width: 1px;
    border-color: #53827d;
    border-radius: 5px;
    padding: 5px 10px;
    margin: 7px 0 0;
    min-height: 29px;
    -unity-font-style: bold;
    font-size: 13px;
}

.tideglass Button:hover, .tideglass Button:focus {
    background-color: #3f6869;
    border-color: #e3c087;
}

.tideglass Button:disabled {
    opacity: 0.65;
}

.tideglass .card-choice Button {
    margin-top: 0;
}

.tideglass .slot Button {
    margin: 0 0 0 7px;
    flex-shrink: 0;
}

.tideglass .primary {
    align-self: flex-start;
    background-color: #e3c087;
    color: #172d31;
}

.tideglass .status {
    background-color: #172e33;
    color: #c7e4d7;
    font-size: 14px;
    padding: 8px 22px;
    flex-shrink: 0;
}

.narrow .tideglass .page {
    padding: 12px;
}

.narrow .tideglass .card-host {
    width: 49%;
}

.narrow .tideglass .inventory {
    width: 100%;
    min-width: 0;
}

.tideglass .route-lights {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 10px;
}

.tideglass .route-lit, .tideglass .route-unlit {
    width: 20px;
    height: 4px;
    margin: 0 3px;
    border-radius: 2px;
}

.tideglass .route-lit {
    background-color: #e9c780;
}

.tideglass .route-unlit {
    background-color: #4b6b6a;
}

.tideglass .primary:hover, .tideglass .primary:focus {
    background-color: #f5d79f;
    color: #172d31;
    border-color: #ffedc6;
}

.tideglass .is-hidden {
    display: none;
}
