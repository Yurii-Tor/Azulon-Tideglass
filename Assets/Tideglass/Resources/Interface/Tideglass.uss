.tideglass {
    flex-grow: 1;
    background-color: #101f25;
    color: #eaf0e6;
}

.tideglass .unity-scroll-view {
    flex-grow: 1;
}

.tideglass .page {
    width: 100%;
    max-width: 1480px;
    align-self: center;
    padding: 18px 30px 24px;
}

.tideglass Label {
    white-space: normal;
    color: #eaf0e6;
    margin: 0;
    padding: 0;
}

.tideglass .eyebrow, .tideglass .spec {
    color: #b7cab9;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.tideglass .header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 0 0 12px;
}

.tideglass .masthead {
    font-size: 36px;
    -unity-font-style: bold;
}

.tideglass .badge {
    color: #ecd4a1;
    font-size: 15px;
    -unity-font-style: bold;
}

.tideglass .station {
    flex-direction: row;
    background-color: #20393d;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 18px;
}

.tideglass .chart {
    width: 33%;
    max-width: 410px;
    background-color: #173035;
    min-height: 166px;
    justify-content: center;
}

.tideglass .beacon-art {
    width: 100%;
    height: 160px;
}

.tideglass .controls {
    flex-grow: 1;
    padding: 14px 20px;
}

.tideglass .headline {
    font-size: 25px;
    -unity-font-style: bold;
}

.tideglass .copy {
    color: #c0d1ca;
    font-size: 14px;
}

.tideglass .power {
    font-size: 18px;
    color: #f4d396;
    -unity-font-style: bold;
    margin-top: 5px;
}

.tideglass .track {
    background-color: #0e272c;
    height: 5px;
    border-radius: 3px;
    margin-top: 5px;
}

.tideglass .fill {
    height: 5px;
    background-color: #e3bf77;
    border-radius: 3px;
}

.tideglass .columns {
    flex-direction: row;
    align-items: flex-start;
}

.tideglass .catalogue {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: 14px;
}

.tideglass .grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.tideglass .card {
    width: 32%;
    margin-right: 1%;
    margin-top: 6px;
    background-color: #1c353a;
    border-radius: 8px;
    padding: 10px;
}

.tideglass .row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.tideglass .item-title {
    -unity-font-style: bold;
    font-size: 16px;
    flex-shrink: 1;
}

.tideglass .icon {
    width: 43px;
    height: 43px;
    margin-right: 7px;
    flex-shrink: 0;
}

.tideglass .spec {
    color: #a5d5c6;
    margin-bottom: 4px;
}

.tideglass .effect {
    color: #eac88a;
    font-size: 13px;
    margin-top: 3px;
}

.tideglass .inventory {
    width: 27%;
    min-width: 218px;
    padding: 14px;
    border-radius: 8px;
    background-color: #20393d;
}

.tideglass .section {
    font-size: 23px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.tideglass .inventory .eyebrow {
    margin: 12px 0 4px;
}

.tideglass .slot {
    padding: 7px 8px;
    margin-top: 3px;
    background-color: #132e32;
    color: #dbddca;
    border-radius: 3px;
}

.tideglass .owned-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin: 3px 0;
}

.tideglass Button {
    white-space: normal;
    background-image: none;
    background-color: #315558;
    color: #edf4e8;
    border-width: 1px;
    border-color: #53827d;
    border-radius: 5px;
    padding: 5px 10px;
    margin: 7px 0 0;
    min-height: 29px;
    -unity-font-style: bold;
    font-size: 13px;
}

.tideglass Button:hover, .tideglass Button:focus {
    background-color: #3f6869;
    border-color: #e3c087;
}

.tideglass Button:disabled {
    opacity: 0.65;
}

.tideglass .primary {
    align-self: flex-start;
    background-color: #e3c087;
    color: #172d31;
}

.tideglass .status {
    background-color: #172e33;
    color: #c7e4d7;
    font-size: 14px;
    padding: 8px 22px;
    flex-shrink: 0;
}

.tideglass.narrow .page {
    padding: 12px;
}

.tideglass.narrow .columns {
    flex-direction: column;
    align-items: stretch;
}

.tideglass.narrow .catalogue {
    margin: 0;
    flex-basis: auto;
}

.tideglass.narrow .card {
    width: 49%;
}

.tideglass.narrow .inventory {
    width: 100%;
    margin-top: 10px;
}

.tideglass.narrow .chart {
    width: 25%;
}

.tideglass .jump-row {
    flex-direction: row;
    margin-bottom: 8px;
}

.tideglass .jump-row Button {
    margin: 0 8px 0 0;
}

.tideglass .route-lights {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 10px;
}

.tideglass .route-lit, .tideglass .route-unlit {
    width: 20px;
    height: 4px;
    margin: 0 3px;
    border-radius: 2px;
}

.tideglass .route-lit {
    background-color: #e9c780;
}

.tideglass .route-unlit {
    background-color: #4b6b6a;
}

.tideglass .primary:hover, .tideglass .primary:focus {
    background-color: #f5d79f;
    color: #172d31;
    border-color: #ffedc6;
}
